# System Environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
WEB_URL=http://localhost:3000
API_URL=http://localhost:5000/api/v1
PUBLIC_MEDIA_URL=http://localhost:8080/media

# Database Connection (MariaDB/MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=annexlk
DB_USER=root
DB_PASSWORD=your_mariadb_password
DB_CONNECTION_LIMIT=10

# JWT Security
JWT_ACCESS_SECRET=your_super_secret_access_key_change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Session Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Google OAuth (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@annexlk.com

# Phone Verification (Mock Provider used by default)
PHONE_OTP_PROVIDER=mock
PHONE_OTP_API_KEY=mock_key_not_needed

# File Upload & Storage Paths
# Paths are absolute or relative to the backend workspace root.
LISTING_STORAGE_PATH=./storage/public/listings
AVATAR_STORAGE_PATH=./storage/public/avatars
KYC_STORAGE_PATH=./storage/private/kyc
TEMP_STORAGE_PATH=./storage/temporary

# Image Limits
MAX_IMAGE_SIZE=5242880 # 5 MB in bytes

# Expiry / Availability confirmation parameters
LISTING_CONFIRMATION_DAYS=14
LISTING_EXPIRY_DAYS=30

# Initial Admin User Credentials (created via seeder/migration)
ADMIN_EMAIL=admin@annexlk.com
ADMIN_INITIAL_PASSWORD=AdminPass123!

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info
